# === Application ===
APP_NAME=finance-service
ENVIRONMENT=development   # development | production

# === Server ===
SERVER_HOST=0.0.0.0
SERVER_PORT=8087
GRPC_PORT=9087

# === Logging ===
LOG_LEVEL=info            # debug | info | warn | error

# === Feature Flags ===
REDIS_ENABLED=true
RABBITMQ_ENABLED=true
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_LIFETIME_HOURS=24
IDEMPOTENCY_LOCK_TIMEOUT_SECONDS=30
IDEMPOTENCY_HEADER=Idempotency-Key

REALTIME_ENABLED=true
REALTIME_SSE_ENABLED=true
REALTIME_WS_ENABLED=true
REALTIME_BRIDGE=redis

# === Database ===
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=coffe_finance
DB_SSLMODE=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/coffe_finance?sslmode=disable

# === Inter-Service Integration ===
APP_SECRET=dev-internal-secret-min-32-characters-needed
INVENTORY_GRPC_URL=localhost:9086
INVENTORY_URL=http://localhost:8086

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# === RabbitMQ ===
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# === JWT ===
JWT_ACCESS_SECRET=dev-jwt-access-secret-minimum-32-characters-ok
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-minimum-32-characters-ok
JWT_ACCESS_DURATION=15
JWT_REFRESH_DURATION=168
JWT_ROTATION_THRESHOLD_DAYS=2
JWT_ISSUER=finance-service
COOKIE_SECURE=false

# === OpenTelemetry ===
OTEL_ENABLED=false
OTEL_SERVICE_NAME=finance-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.2
